# FIRINGI production settings — copy to production.env (never commit it) and fill in.
# FIRINGI refuses to start when something essential is missing or unsafe (System Health lists
# what to fix). Generate secrets with:  openssl rand -base64 48

# ── Address & secrets ──
DOMAIN="app.example.com"                      # for the optional Caddy HTTPS (--profile https)
BETTER_AUTH_URL="https://app.example.com"
APP_URL="https://app.example.com"
BETTER_AUTH_SECRET=""                         # 32+ random characters
CRON_SECRET=""                                # 24+ random characters (scheduler, backups, /api/health?full=1)
POSTGRES_PASSWORD=""                          # the database password (compose builds DATABASE_URL from it)
GIT_COMMIT=""                                 # e.g. $(git rev-parse --short HEAD) at build time
FIRINGI_VERSION="latest"                      # image tag
APP_PORT="3000"
SEED_DEMO="false"                             # never create demo accounts in production
AUTH_SIGNIN_RATE_LIMIT="10"

# ── First super admin (prisma/seed/bootstrap.ts, run once) ──
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""                             # 12+ characters; change it after the first sign-in
COMPANY_LEGAL_NAME="FIRINGI, Lda"
COMPANY_TAX_ID=""
COMPANY_COUNTRY="PT"

# ── Files ── "local" keeps them in the "storage" volume (back it up!), "s3" = S3-compatible storage
STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION="eu-central-1"
S3_ENDPOINT=""                                # empty for AWS; https://… for other providers
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=""                        # "true" for MinIO and most non-AWS providers
S3_SSE=""                            # "AES256" = ask the provider to encrypt at rest (AWS); leave empty if it refuses

# ── Backups (service "backup") ──
BACKUP_ENCRYPTION_KEY=""                      # keep a copy OUTSIDE this server — without it backups can't be restored
BACKUP_RETENTION_DAYS="30"
BACKUP_HOUR="2"                               # UTC; the backup runs at HH:15
RESTORE_TEST_DAY="1"                          # day of the month for the automatic restore test
BACKUP_S3_BUCKET=""                           # off-site copy (defaults to S3_BUCKET; set BACKUP_S3=off to skip)
BACKUP_ON_START="0"

# ── Monitoring ──
SENTRY_DSN=""                                 # optional; FIRINGI's own error log + alerts always work
SENTRY_TRACES_SAMPLE_RATE="0"
ALERT_ERRORS_15MIN="20"
DB_SIZE_WARN_GB="20"

# ── Messages ──
MAIL_DRIVER="smtp"
SMTP_URL=""                                   # smtps://user:pass@smtp.example.com:465
MAIL_FROM="FIRINGI <no-reply@example.com>"
SMS_DRIVER="log"                              # log | twilio
WHATSAPP_DRIVER="log"                         # log | twilio | meta
PUSH_DRIVER="log"                             # log | webpush
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
TWILIO_WEBHOOK_URL=""
TWILIO_STATUS_CALLBACK=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:no-reply@example.com"

# ── Customer payments online (MB WAY, Multibanco, card, SEPA direct debit) ──
STRIPE_SECRET_KEY=""                          # sk_live_… (empty = bank transfer only)
STRIPE_WEBHOOK_SECRET=""                      # whsec_… — webhook https://<DOMAIN>/api/webhooks/payments/stripe
# Bank feed for bank reconciliation (optional; FIRINGI switches it on in Finance › Bank Reconciliation › Settings)
GOCARDLESS_SECRET_ID=""                       # GoCardless Bank Account Data — user secrets
GOCARDLESS_SECRET_KEY=""

# ── Integrations ──
VIES_URL="https://ec.europa.eu/taxation_customs/vies/rest-api/check-vat-number"
ANTHROPIC_API_KEY=""                          # AI Business Assistant (optional)
MOLONI_CLIENT_ID=""                           # certified invoicing (Portugal)
MOLONI_CLIENT_SECRET=""
MOLONI_USERNAME=""
MOLONI_PASSWORD=""
MOLONI_SANDBOX=""
