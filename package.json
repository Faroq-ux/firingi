{
  "name": "firingi",
  "version": "0.1.0",
  "private": true,
  "description": "FIRINGI — B2B marketplace + ERP (core module)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:int": "vitest run tests/integration"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "4.3.0",
    "better-auth": "1.3.34",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "lucide-react": "0.544.0",
    "next": "15.5.29",
    "next-intl": "4.3.12",
    "nodemailer": "7.0.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "web-push": "3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/nodemailer": "7.0.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/web-push": "3.6.4",
    "dotenv": "17.2.2",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.29",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
