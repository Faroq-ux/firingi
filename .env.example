# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/firingi"
# Used by integration tests (wiped by the tests!)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/firingi_test"

# better-auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Default password given to seeded demo users (dev only)
SEED_PASSWORD="Firingi!2026"
AUTH_SIGNIN_RATE_LIMIT="10"

# File storage for uploads (documents, delivery photos, PDFs): "local" = STORAGE_DIR on this disk,
# "s3" = any S3-compatible storage (AWS S3, MinIO, Hetzner, Scaleway, Cloudflare R2, …)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
S3_BUCKET=""
S3_REGION="eu-west-1"
S3_ENDPOINT=""                       # empty for AWS; http://localhost:8333 for the dev compose (SeaweedFS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=""               # "true" for SeaweedFS / MinIO and most non-AWS providers
S3_SSE=""                            # "AES256" = ask the provider to encrypt at rest (AWS); leave empty if it refuses

# E-mail: "log" writes messages to STORAGE_DIR/mail-outbox (dev); "smtp" sends via SMTP_URL
MAIL_DRIVER="log"
SMTP_URL="smtp://localhost:1025"
MAIL_FROM="FIRINGI <no-reply@firingi.test>"

# EU VIES VAT validation endpoint
VIES_URL="https://ec.europa.eu/taxation_customs/vies/rest-api/check-vat-number"
# Tests / development only: answer VIES checks without the network (numbers ending in 000 are not valid)
# VIES_SIMULATE=1

# ── Notifications (Phase 7) ── "log" writes messages to STORAGE_DIR/notify-outbox (development)
APP_URL="http://localhost:3000"      # links in e-mails / SMS / WhatsApp
SMS_DRIVER="log"                     # log | twilio
WHATSAPP_DRIVER="log"                # log | twilio | meta
PUSH_DRIVER="log"                    # log | webpush
# Twilio (SMS and/or WhatsApp)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""                   # +351…
TWILIO_WHATSAPP_FROM=""              # whatsapp:+351…
TWILIO_WEBHOOK_URL=""                # public URL of /api/webhooks/twilio (signature check)
TWILIO_STATUS_CALLBACK=""            # usually the same URL
# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""               # signs webhook calls to /api/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=""             # Meta webhook subscription check
WHATSAPP_PUBLIC_NUMBER=""            # Phase 58: FIRINGI's ordering number shown to customers (else the landing page's)
STT_URL=""                           # Phase 58: speech-to-text for voice notes (OpenAI-compatible /audio/transcriptions)
STT_API_KEY=""
STT_MODEL=""                         # default whisper-1
WA_MEDIA_SIMULATE=""                 # 1 = fake WhatsApp media and transcripts (tests / development only)
# Web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:no-reply@firingi.test"
# Scheduled jobs, each called with "Authorization: Bearer $CRON_SECRET":
#   /api/cron/notifications every few minutes (message retries)
#   /api/cron/allocation every 10–15 minutes (moves orders suppliers did not confirm in time)
#   /api/cron/ai hourly (recomputes the AI suggestions)
#   /api/cron/invoicing every 5 minutes (sends documents to Moloni, supplier payout reminders)
CRON_SECRET=""
# AI Business Assistant (Claude via the Anthropic API). Empty = assistant off; the other AI
# Centre insights work without it. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=""
# Certified invoicing through Moloni (moloni.pt). Empty = FIRINGI's internal (non-fiscal) numbering.
MOLONI_CLIENT_ID=""
MOLONI_CLIENT_SECRET=""
MOLONI_USERNAME=""
MOLONI_PASSWORD=""
MOLONI_SANDBOX=""                    # "true" = Moloni's sandbox
MOLONI_SIMULATE=""                   # "1" = built-in simulated Moloni (development / demos, not fiscal)
# Phase 46 — e-invoicing services (see docs/e-invoicing.md); without keys a service is "not connected"
EINVOICE_SIMULATE=""                 # "1" = built-in e-invoice test network (development / demos)
POS_FISCAL_SIMULATE=""               # "1" = simulated certified till-receipt providers (development / demos)
POS_SECRET_KEY=""                    # key for businesses' till-provider secrets (default: derived from BETTER_AUTH_SECRET)
EINVOICE_HUB_URL=""                  # EU-wide e-invoicing service
EINVOICE_HUB_KEY=""
PEPPOL_AP_URL=""                     # Peppol access point
PEPPOL_AP_KEY=""
KSEF_URL=""                          # Poland KSeF
KSEF_TOKEN=""
SDI_URL=""                           # Italy SDI intermediary
SDI_KEY=""
AEAT_URL=""                          # Spain AEAT Verifactu
AEAT_KEY=""
EINVOICE_INBOUND_SECRET=""           # bearer secret for POST /api/einvoice/inbound (≥ 16 characters)
# ── Production readiness (Phase 19) ──
FIRINGI_ENV=""                       # "production" = refuse to start on unsafe/missing settings
GIT_COMMIT=""                        # build id shown on System Health and /api/health
SENTRY_DSN=""                        # optional external error tracking (browser + server)
SENTRY_TRACES_SAMPLE_RATE="0"
ALERT_ERRORS_15MIN="20"              # server errors in 15 min that raise an alert (×5 = critical)
DB_SIZE_WARN_GB="20"
BACKUP_ENCRYPTION_KEY=""             # used by the backup service (docker-compose.prod.yml)
# ── Customer payments online (Phase 20) ──
PAYMENTS_SIMULATE=""                 # "1" = built-in simulated provider (development / demos — no real money)
PAYMENTS_PROVIDER=""                 # optional: "stripe" | "sim" (default: simulator if PAYMENTS_SIMULATE=1, Stripe if a key is set)
STRIPE_SECRET_KEY=""                 # sk_test_… / sk_live_…
STRIPE_WEBHOOK_SECRET=""             # whsec_… for https://<domain>/api/webhooks/payments/stripe
