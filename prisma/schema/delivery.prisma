// ───────────────────────── Delivery & fleet ─────────────────────────

enum ServiceAreaType {
  COUNTRY // distributors (cross-border within EU)
  REGION
  CITY
  ZONE
  RADIUS_KM // radius around one of the vendor's addresses
}

/// How a supplier's free-delivery minimum is counted.
enum DeliveryMinimumKind {
  AMOUNT // order value (excl. VAT)
  UNITS // number of selling units (packs / cases) in the order
}

enum DeliveryRuleScope {
  COUNTRY
  ZONE
  VENDOR
  VENDOR_AREA
}

enum VehicleStatus {
  PENDING_APPROVAL
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum DriverAvailability {
  AVAILABLE
  BUSY
  OFF_DUTY
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

model DeliveryZone {
  id                 String                    @id @default(cuid())
  countryId          String
  name               String
  postalCodePatterns String[] // e.g. ["1000-*", "1100-*"]
  polygon            Json? // GeoJSON as entered; `area` is the PostGIS geography built from it
  area               Unsupported("geography")?
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())

  country      Country             @relation(fields: [countryId], references: [id])
  serviceAreas VendorServiceArea[]
  rules        DeliveryRule[]

  @@index([area], map: "DeliveryZone_area_idx", type: Gist)
}

/// Where a vendor sells / delivers. Wholesalers: own country only (enforced in service).
model VendorServiceArea {
  id              String          @id @default(cuid())
  vendorCompanyId String
  type            ServiceAreaType
  countryId       String
  regionId        String?
  cityId          String?
  zoneId          String?
  originAddressId String? // RADIUS_KM
  radiusKm        Decimal?        @db.Decimal(8, 2)
  ownFleet        Boolean         @default(true) // vendor delivers with own fleet here
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  vendor        Company        @relation(fields: [vendorCompanyId], references: [id], onDelete: Cascade)
  country       Country        @relation(fields: [countryId], references: [id])
  region        Region?        @relation(fields: [regionId], references: [id])
  city          City?          @relation(fields: [cityId], references: [id])
  zone          DeliveryZone?  @relation(fields: [zoneId], references: [id])
  originAddress Address?       @relation(fields: [originAddressId], references: [id])
  rules         DeliveryRule[]

  @@index([vendorCompanyId])
}

/// Two kinds of rule (most specific active one of each kind wins):
///  • FIRINGI delivery rule — scope COUNTRY / ZONE, set by FIRINGI admin:
///      minOrderValue = minimum order for FIRINGI to deliver, firingiDeliveryFeeNet = fee charged.
///  • Vendor delivery minimum — scope VENDOR / VENDOR_AREA, set by the vendor:
///      vendorDeliveryMinimum = from this order value the vendor delivers with its own fleet.
/// At checkout: goods ≥ vendor minimum → vendor delivers; else goods ≥ FIRINGI minimum →
/// FIRINGI delivers (+fee); else checkout is blocked.
model DeliveryRule {
  id                    String              @id @default(cuid())
  scope                 DeliveryRuleScope
  countryId             String
  zoneId                String?
  vendorCompanyId       String?
  serviceAreaId         String?
  minOrderValue         Decimal?            @db.Decimal(18, 2)
  firingiDeliveryFeeNet Decimal?            @db.Decimal(18, 2)
  feeTaxCategoryId      String?
  vendorDeliveryMinimum Decimal?            @db.Decimal(18, 2)
  /// FIRINGI (COUNTRY / ZONE rules, customer orders only): free FIRINGI delivery from this value, when switched on.
  firingiFreeEnabled    Boolean             @default(false)
  firingiFreeFrom       Decimal?            @db.Decimal(18, 2)
  /// Supplier (VENDOR rules): minimum counted by amount or by units, and the supplier's own flat rate below it.
  vendorMinimumKind     DeliveryMinimumKind @default(AMOUNT)
  vendorMinimumUnits    Int?
  vendorFlatFeeNet      Decimal?            @db.Decimal(18, 2)
  priority              Int                 @default(0)
  validFrom             DateTime            @default(now())
  validTo               DateTime?
  isActive              Boolean             @default(true)
  updatedById           String?
  createdAt             DateTime            @default(now())

  country        Country            @relation(fields: [countryId], references: [id])
  zone           DeliveryZone?      @relation(fields: [zoneId], references: [id])
  vendor         Company?           @relation(fields: [vendorCompanyId], references: [id])
  serviceArea    VendorServiceArea? @relation(fields: [serviceAreaId], references: [id])
  feeTaxCategory TaxCategory?       @relation(fields: [feeTaxCategoryId], references: [id])
  orders         Order[]
}

model Vehicle {
  id             String        @id @default(cuid())
  ownerCompanyId String // FIRINGI (admin fleet) or a vendor
  plate          String
  type           String // van, truck, refrigerated …
  make           String?
  model          String?
  capacityKg     Decimal?      @db.Decimal(10, 2)
  capacityM3     Decimal?      @db.Decimal(10, 2)
  isRefrigerated Boolean       @default(false)
  status         VehicleStatus @default(PENDING_APPROVAL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  owner      Company    @relation(fields: [ownerCompanyId], references: [id])
  documents  Document[]
  deliveries Delivery[]
  routes     Route[]

  @@unique([ownerCompanyId, plate])
}

model Driver {
  id             String             @id @default(cuid())
  userId         String             @unique
  ownerCompanyId String // FIRINGI or the vendor that employs the driver
  licenceNumber  String
  licenceExpiry  DateTime?
  status         AccountStatus      @default(PENDING) // admin approval required
  availability   DriverAvailability @default(OFF_DUTY)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user        User              @relation(fields: [userId], references: [id])
  owner       Company           @relation(fields: [ownerCompanyId], references: [id])
  documents   Document[]
  deliveries  Delivery[]
  routes      Route[]
  chargebacks ClaimChargeback[] @relation("ChargebackDriver")
}

/// One delivery per order (retries after a failed attempt reuse it; each try is a DeliveryAttempt).
model Delivery {
  id                 String         @id @default(cuid())
  orderId            String         @unique
  mode               DeliveryMode
  executingCompanyId String
  driverId           String?
  vehicleId          String?
  carrierName        String?
  trackingNumber     String?
  status             DeliveryStatus @default(UNASSIGNED)
  scheduledFor       DateTime?
  eta                DateTime?
  feeNet             Decimal        @default(0) @db.Decimal(18, 2)
  notes              String?
  routeId            String? // open route this delivery is on
  assignedAt         DateTime?
  assignedById       String?
  pickedUpAt         DateTime?
  completedAt        DateTime?
  /// Phase 43: licensed goods — the driver checked the customer's licence / ID; accompanying excise document
  exciseCheckedAt    DateTime?
  exciseCheckedById  String?
  exciseDocType      String?
  exciseDocRef       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order    Order             @relation(fields: [orderId], references: [id])
  executor Company           @relation(fields: [executingCompanyId], references: [id])
  driver   Driver?           @relation(fields: [driverId], references: [id])
  vehicle  Vehicle?          @relation(fields: [vehicleId], references: [id])
  attempts DeliveryAttempt[]
  proof    ProofOfDelivery?
  route    Route?            @relation(fields: [routeId], references: [id], onDelete: SetNull)
  stops    RouteStop[]

  @@index([executingCompanyId, status])
  @@index([driverId, status])
  @@index([routeId])
}

model DeliveryAttempt {
  id            String   @id @default(cuid())
  deliveryId    String
  at            DateTime @default(now())
  succeeded     Boolean
  reasonCode    String? // CUSTOMER_ABSENT | CLOSED | REFUSED | WRONG_ADDRESS | DAMAGED | NO_PAYMENT | OTHER
  failureReason String? // driver's note
  photoKey      String?
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  byUserId      String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
}

model ProofOfDelivery {
  id            String   @id @default(cuid())
  deliveryId    String   @unique
  photoKeys     String[]
  signatureKey  String?
  recipientName String
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  at            DateTime @default(now())
  byUserId      String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}
