// ───────────────────────── Delivery & fleet ─────────────────────────

enum ServiceAreaType {
  COUNTRY   // distributors (cross-border within EU)
  REGION
  CITY
  ZONE
  RADIUS_KM // radius around one of the vendor's addresses
}

enum DeliveryRuleScope {
  COUNTRY
  ZONE
  VENDOR
  VENDOR_AREA
}

enum VehicleStatus {
  PENDING_APPROVAL
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum DriverAvailability {
  AVAILABLE
  BUSY
  OFF_DUTY
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

model DeliveryZone {
  id                 String   @id @default(cuid())
  countryId          String
  name               String
  postalCodePatterns String[] // e.g. ["1000-*", "1100-*"]
  polygon            Json?    // GeoJSON (PostGIS geometry added in Phase 6)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  country      Country             @relation(fields: [countryId], references: [id])
  serviceAreas VendorServiceArea[]
  rules        DeliveryRule[]
}

/// Where a vendor sells / delivers. Wholesalers: own country only (enforced in service).
model VendorServiceArea {
  id              String          @id @default(cuid())
  vendorCompanyId String
  type            ServiceAreaType
  countryId       String
  regionId        String?
  cityId          String?
  zoneId          String?
  originAddressId String?         // RADIUS_KM
  radiusKm        Decimal?        @db.Decimal(8, 2)
  ownFleet        Boolean         @default(true) // vendor delivers with own fleet here
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  vendor        Company       @relation(fields: [vendorCompanyId], references: [id], onDelete: Cascade)
  country       Country       @relation(fields: [countryId], references: [id])
  region        Region?       @relation(fields: [regionId], references: [id])
  city          City?         @relation(fields: [cityId], references: [id])
  zone          DeliveryZone? @relation(fields: [zoneId], references: [id])
  originAddress Address?      @relation(fields: [originAddressId], references: [id])
  rules         DeliveryRule[]
}

/// Most specific active rule wins: VENDOR_AREA > VENDOR > ZONE > COUNTRY.
/// below minOrderValue → checkout blocked; ≥ freeDeliveryThreshold (inside own-fleet
/// area) → vendor delivers free; otherwise FIRINGI delivers and charges the fee.
model DeliveryRule {
  id                    String            @id @default(cuid())
  scope                 DeliveryRuleScope
  countryId             String
  zoneId                String?
  vendorCompanyId       String?
  serviceAreaId         String?
  minOrderValue         Decimal           @db.Decimal(18, 2)
  freeDeliveryThreshold Decimal           @db.Decimal(18, 2)
  firingiDeliveryFeeNet Decimal           @db.Decimal(18, 2)
  feeTaxCategoryId      String
  priority              Int               @default(0)
  validFrom             DateTime          @default(now())
  validTo               DateTime?
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())

  country        Country            @relation(fields: [countryId], references: [id])
  zone           DeliveryZone?      @relation(fields: [zoneId], references: [id])
  vendor         Company?           @relation(fields: [vendorCompanyId], references: [id])
  serviceArea    VendorServiceArea? @relation(fields: [serviceAreaId], references: [id])
  feeTaxCategory TaxCategory        @relation(fields: [feeTaxCategoryId], references: [id])
  orders         Order[]
}

model Vehicle {
  id             String        @id @default(cuid())
  ownerCompanyId String        // FIRINGI (admin fleet) or a vendor
  plate          String
  type           String        // van, truck, refrigerated …
  make           String?
  model          String?
  capacityKg     Decimal?      @db.Decimal(10, 2)
  capacityM3     Decimal?      @db.Decimal(10, 2)
  isRefrigerated Boolean       @default(false)
  status         VehicleStatus @default(PENDING_APPROVAL)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  owner      Company    @relation(fields: [ownerCompanyId], references: [id])
  documents  Document[]
  deliveries Delivery[]

  @@unique([ownerCompanyId, plate])
}

model Driver {
  id             String             @id @default(cuid())
  userId         String             @unique
  ownerCompanyId String             // FIRINGI or the vendor that employs the driver
  licenceNumber  String
  licenceExpiry  DateTime?
  status         AccountStatus      @default(PENDING) // admin approval required
  availability   DriverAvailability @default(OFF_DUTY)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  owner      Company    @relation(fields: [ownerCompanyId], references: [id])
  documents  Document[]
  deliveries Delivery[]
}

model Delivery {
  id                 String         @id @default(cuid())
  orderId            String
  mode               DeliveryMode
  executingCompanyId String
  driverId           String?
  vehicleId          String?
  carrierName        String?
  trackingNumber     String?
  status             DeliveryStatus @default(UNASSIGNED)
  scheduledFor       DateTime?
  eta                DateTime?
  feeNet             Decimal        @default(0) @db.Decimal(18, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order     Order             @relation(fields: [orderId], references: [id])
  executor  Company           @relation(fields: [executingCompanyId], references: [id])
  driver    Driver?           @relation(fields: [driverId], references: [id])
  vehicle   Vehicle?          @relation(fields: [vehicleId], references: [id])
  attempts  DeliveryAttempt[]
  proof     ProofOfDelivery?
}

model DeliveryAttempt {
  id            String   @id @default(cuid())
  deliveryId    String
  at            DateTime @default(now())
  succeeded     Boolean
  failureReason String?
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  byUserId      String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model ProofOfDelivery {
  id            String   @id @default(cuid())
  deliveryId    String   @unique
  photoKeys     String[]
  signatureKey  String?
  recipientName String
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  at            DateTime @default(now())
  byUserId      String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}
