// ───────────────────────── Identity, tenancy, RBAC, audit ─────────────────────────

enum CompanyType {
  ADMIN // FIRINGI itself (merchant of record)
  DISTRIBUTOR // vendor — sells to wholesalers only (cross-border within EU allowed)
  WHOLESALER // vendor + buyer — sells to customers in its own country, buys from distributors
  CUSTOMER // wholesale business customer — buys from wholesalers only
}

/// Shared by companies and drivers: every registration must be approved by admin.
enum AccountStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

/// Which portal / area a permission belongs to.
enum PermissionAudience {
  ADMIN // FIRINGI back office
  VENDOR // sell portal (distributors, wholesalers)
  BUYER // buy portal (customers, wholesalers buying from distributors)
  COMPANY // company self-management (team, profile, documents) — any non-admin company
  DRIVER // driver portal
}

// ---- better-auth core tables (field names required by better-auth) ----

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String
  emailVerified     Boolean    @default(false)
  image             String?
  phone             String?
  locale            String? // preferred UI language (must be a country language or "en")
  /// Explicit consent (GDPR) to receive SMS / WhatsApp messages on `phone`.
  smsConsentAt      DateTime?
  whatsappConsentAt DateTime?
  status            UserStatus @default(ACTIVE)
  /// Two-factor login (authenticator app) is on.
  twoFactorEnabled  Boolean?   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions                Session[]
  accounts                Account[]
  twoFactors              TwoFactor[]
  dataRequests            DataRequest[]
  memberships             Membership[]
  driver                  Driver?
  notifications           Notification[]
  notificationMessages    NotificationMessage[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  inboundMessages         InboundMessage[]
  carts                   Cart[]
  ordersPlaced            Order[]                  @relation("OrderPlacedBy")
  regionalManagerOf       Company[]                @relation("RegionalManager")
}

/// Authenticator-app secret and backup codes (encrypted by better-auth).
model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String @unique // one authenticator per user

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id              String   @id @default(cuid())
  token           String   @unique
  userId          String
  expiresAt       DateTime
  ipAddress       String?
  userAgent       String?
  /// The company the user is currently acting for (users can belong to several).
  activeCompanyId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // scrypt hash (credential provider)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---- Tenancy ----

/// One table for every account. "Vendor" = DISTRIBUTOR | WHOLESALER.
/// A wholesaler is ONE company that uses both the Sell and the Buy portal.
model Company {
  id                  String        @id @default(cuid())
  type                CompanyType
  status              AccountStatus @default(PENDING)
  legalName           String
  tradeName           String?
  taxId               String // national tax id (NIF in PT)
  vatNumber           String? // EU VAT number incl. prefix (validated with VIES)
  countryId           String
  email               String
  phone               String?
  website             String?
  businessType        String? // restaurant, kebab/pizza, mini-market … (customers)
  /// FIRINGI's own in-house warehouse, run as a wholesaler (managed by FIRINGI staff).
  isInHouse           Boolean       @default(false)
  defaultCurrencyCode String        @default("EUR")
  defaultLanguageCode String?
  creditLimit         Decimal?      @db.Decimal(18, 2)
  paymentTermsDays    Int           @default(0)
  regionalManagerId   String?
  notes               String?
  approvedAt          DateTime?
  approvedById        String?
  statusReason        String? // rejection / suspension reason
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  country                  Country                     @relation(fields: [countryId], references: [id])
  regionalManager          User?                       @relation("RegionalManager", fields: [regionalManagerId], references: [id])
  memberships              Membership[]
  roles                    Role[]
  statusHistory            CompanyStatusHistory[]
  addresses                Address[]
  documents                Document[]
  restrictionApprovals     RestrictionApproval[]
  vatValidations           VatValidation[]
  productsProposed         Product[]
  vendorOffers             VendorOffer[]
  customerGroupsOwned      CustomerGroup[]             @relation("GroupOwner")
  customerGroupMemberships CustomerGroupMember[]
  priceListsOwned          PriceList[]                 @relation("PriceListVendor")
  priceListsTargeted       PriceList[]                 @relation("PriceListTargetCompany")
  carts                    Cart[]                      @relation("CartBuyer")
  cartsAsSeller            Cart[]                      @relation("CartSeller")
  ordersAsBuyer            Order[]                     @relation("OrderBuyer")
  ordersAsSeller           Order[]                     @relation("OrderSeller")
  allocationsFrom          AllocationEvent[]           @relation("AllocationFrom")
  allocationProfile        VendorAllocationProfile?
  apiKeys                  ApiKey[]
  routes                   Route[]
  commissionRules          CommissionRule[]
  promotions               Promotion[]
  promotionTargets         PromotionTarget[]
  promotionAcceptances     PromotionVendorAcceptance[]
  billingStatements        VendorBillingStatement[]
  vendorInvoices           VendorInvoice[]
  invoicesReceived         Invoice[]                   @relation("InvoiceRecipient")
  payments                 Payment[]
  serviceAreas             VendorServiceArea[]
  deliveryRules            DeliveryRule[]
  vehicles                 Vehicle[]
  drivers                  Driver[]
  deliveries               Delivery[]

  @@unique([countryId, taxId, type])
  @@index([type, status])
}

model CompanyStatusHistory {
  id         String         @id @default(cuid())
  companyId  String
  fromStatus AccountStatus?
  toStatus   AccountStatus
  reason     String?
  byUserId   String?
  at         DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, at])
}

/// FIRINGI's own invoicing entity per country (Portugal at launch). Issuer of every sales invoice.
model LegalEntity {
  id          String   @id @default(cuid())
  countryId   String
  legalName   String
  taxId       String
  vatNumber   String
  addressLine String
  postalCode  String
  city        String
  email       String
  phone       String?
  iban        String?
  logoKey     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country       Country         @relation(fields: [countryId], references: [id])
  invoiceSeries InvoiceSeries[]
  invoices      Invoice[]

  @@unique([countryId, taxId])
}

model Membership {
  id          String           @id @default(cuid())
  userId      String
  companyId   String
  isOwner     Boolean          @default(false)
  status      MembershipStatus @default(ACTIVE)
  jobTitle    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdById String?

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles   MembershipRole[]
  scopes  MembershipScope[]

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Limits a member (e.g. Regional Manager) to a country / region. No rows = unrestricted.
model MembershipScope {
  id           String  @id @default(cuid())
  membershipId String
  countryId    String?
  regionId     String?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  country    Country?   @relation(fields: [countryId], references: [id])
  region     Region?    @relation(fields: [regionId], references: [id])
}

// ---- RBAC ----

/// Permissions are defined in code (src/server/rbac/permissions.ts) and synced by the seed.
model Permission {
  code        String             @id // e.g. "buyer.orders.place"
  audience    PermissionAudience
  module      String
  description String

  roles RolePermission[]
}

/// companyId = null  → system role template (seeded, read-only), usable by companies whose
///                     type is listed in `appliesTo`.
/// companyId = set   → custom role created by that company for its own employees.
model Role {
  id          String        @id @default(cuid())
  companyId   String?
  key         String // stable key, e.g. SUPER_ADMIN, BUYER_PURCHASER, custom-xyz
  name        String
  description String?
  appliesTo   CompanyType[]
  isSystem    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     MembershipRole[]

  @@unique([companyId, key])
}

model RolePermission {
  roleId         String
  permissionCode String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
}

model MembershipRole {
  membershipId String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

// ---- Audit (append-only, enforced by DB trigger) ----

model AuditLog {
  id             String   @id @default(cuid())
  at             DateTime @default(now())
  actorUserId    String?
  actorCompanyId String?
  action         String // e.g. "company.approved", "role.updated", "auth.login"
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  meta           Json?
  ip             String?
  userAgent      String?

  @@index([entityType, entityId])
  @@index([actorCompanyId, at])
  @@index([at])
}
