// ───────────────────────── Marketing campaigns (Phase 15) ─────────────────────────

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum RecipientStatus {
  QUEUED
  SENT
  SKIPPED
  FAILED
}

/// A message to an audience of business customers (and/or suppliers) on one or more channels,
/// optionally promoting an offer / coupon. Texts per language ({ en, pt, es, … }); missing
/// languages fall back to English. Marketing respects each user's opt-out.
model MarketingCampaign {
  id             String                @id @default(cuid())
  name           String
  status         CampaignStatus        @default(DRAFT)
  channels       NotificationChannel[]
  /// { segmentId?, types?: CUSTOMER|WHOLESALER|DISTRIBUTOR[], countryCodes?: string[], companyIds?: string[] }
  audience       Json
  subject        Json
  body           Json
  ctaLabel       Json?
  /// Where the button / link goes (a page in FIRINGI, e.g. /buy/marketing/offers).
  ctaPath        String?
  promotionId    String?
  crmSegmentId   String?
  /// Meta-approved WhatsApp marketing template (name, language); without it WhatsApp is skipped.
  waTemplateName String?
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  promotion  Promotion?          @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  segment    CrmSegment?         @relation(fields: [crmSegmentId], references: [id], onDelete: SetNull)
  recipients CampaignRecipient[]

  @@index([status, scheduledAt])
}

/// One person × channel of a campaign. `token` identifies opens, clicks and unsubscribes.
model CampaignRecipient {
  id         String              @id @default(cuid())
  campaignId String
  userId     String
  companyId  String
  channel    NotificationChannel
  status     RecipientStatus     @default(QUEUED)
  skipReason String?
  messageId  String?
  token      String              @unique
  openedAt   DateTime?
  clickedAt  DateTime?
  createdAt  DateTime            @default(now())

  campaign MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId, channel])
  @@index([companyId, clickedAt])
  @@index([userId])
}

// ───────────────────────── Marketing catalogues ─────────────────────────

enum MarketingCatalogueScope {
  ALL // every wholesaler in the country
  WHOLESALER // these wholesalers
  ZONE // wholesalers serving these delivery zones
  DISTRICT // wholesalers serving these districts (regions)
}

enum MarketingCatalogueStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A product catalogue / brochure FIRINGI makes for marketing (by hand or with AI): a PDF and a share link with
/// a QR code per product. Or FIRINGI's own PDF uploaded (uploadKey) and shared the same way.
model MarketingCatalogue {
  id          String                   @id @default(cuid())
  title       String
  subtitle    String?
  intro       String?
  /// language of the texts and product names (e.g. pt-PT)
  locale      String                   @default("pt-PT")
  countryId   String
  scope       MarketingCatalogueScope  @default(ALL)
  /// wholesaler / zone / region ids for the scope
  scopeIds    String[]
  /// how products are picked: { categoryIds?, brandIds?, q?, bestSellers?, withImages?, max? }
  filters     Json
  /// the chosen offers in order: [{ offerId, section? }]
  items       Json
  /// GRID4 | GRID6 | GRID9 | LIST
  layout      String                   @default("GRID6")
  /// { price: NONE|NET|GROSS, barcode, qty, supplier: NONE|NAME|AREA, qr }
  options     Json
  /// own PDF instead of the generated one
  uploadKey   String?
  shareToken  String                   @unique
  status      MarketingCatalogueStatus @default(DRAFT)
  aiPrompt    String?
  /// the campaign it was sent with (latest)
  campaignId  String?
  views       Int                      @default(0)
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  publishedAt DateTime?

  @@index([status, createdAt])
}
