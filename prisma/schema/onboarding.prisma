// ───────────────────────── Onboarding & compliance ─────────────────────────

enum AddressKind {
  HEAD_OFFICE
  BILLING
  WAREHOUSE // vendor distribution / warehouse address (stock location)
  PICKUP // vendor wholesale / pickup address
  DELIVERY // buyer delivery address
}

enum DocumentType {
  BUSINESS_REGISTRATION
  TAX_ID_CERTIFICATE
  TRADE_LICENCE
  TOBACCO_LICENCE
  ALCOHOL_LICENCE
  ID_DOCUMENT
  DRIVING_LICENCE
  VEHICLE_REGISTRATION
  VEHICLE_INSURANCE
  SELF_BILLING_AGREEMENT
  CONTRACT
  OTHER
  POS_INVOICE // Phase 28: a recent invoice from the customer's own till (proves the shop trades)
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum Restriction {
  TOBACCO
  ALCOHOL
}

enum VatValidationResult {
  VALID
  INVALID
  ERROR
}

model Address {
  id           String                    @id @default(cuid())
  companyId    String
  kind         AddressKind
  label        String
  line1        String
  line2        String?
  postalCode   String
  cityId       String?
  cityName     String // free text fallback / display
  countryId    String
  latitude     Decimal?                  @db.Decimal(9, 6) // from geocoding / the city's centre
  longitude    Decimal?                  @db.Decimal(9, 6)
  /// PostGIS point kept in sync with latitude / longitude by a trigger (read-only, SQL only).
  geo          Unsupported("geography")?
  contactName  String?
  phone        String?
  openingHours Json?
  isDefault    Boolean                   @default(false)
  isActive     Boolean                   @default(true)
  /// Phase 27: the branch this delivery address belongs to
  branchId     String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch             Branch?             @relation("BranchAddresses", fields: [branchId], references: [id], onDelete: SetNull)
  city               City?               @relation(fields: [cityId], references: [id])
  country            Country             @relation(fields: [countryId], references: [id])
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  stockBatches       StockBatch[]
  purchaseOrders     PurchaseOrder[]     @relation("PurchaseOrderAddress")
  stockCounts        StockCount[]        @relation("StockCountAddress")
  transfersFrom      StockTransfer[]     @relation("StockTransferFrom")
  transfersTo        StockTransfer[]     @relation("StockTransferTo")
  radiusAreas        VendorServiceArea[]
  ordersFrom         Order[]             @relation("OrderSourceAddress")
  bins               Bin[]               @relation("BinAddress")
  pickLists          PickList[]          @relation("PickListAddress")
  planningItems      PlanningItem[]      @relation("PlanningItemAddress")
  restockSuggestions RestockSuggestion[] @relation("RestockSuggestionAddress")

  @@index([companyId, kind])
  @@index([geo], map: "Address_geo_idx", type: Gist)
}

model Document {
  id                    String       @id @default(cuid())
  companyId             String?
  driverId              String?
  vehicleId             String?
  restrictionApprovalId String?
  type                  DocumentType
  fileKey               String // object-storage key
  fileName              String
  mimeType              String
  sizeBytes             Int
  status                ReviewStatus @default(PENDING)
  expiresAt             DateTime?
  /// Phase 28: date on the document (the POS invoice's date)
  issuedOn              DateTime?    @db.Date
  reviewedById          String?
  reviewedAt            DateTime?
  reviewNote            String?
  uploadedById          String?
  createdAt             DateTime     @default(now())

  company             Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  driver              Driver?              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle             Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  restrictionApproval RestrictionApproval? @relation(fields: [restrictionApprovalId], references: [id])

  @@index([companyId])
  @@index([status])
}

/// A buyer must be approved per restriction (tobacco / alcohol) before it can see or buy
/// restricted products.
model RestrictionApproval {
  id           String       @id @default(cuid())
  companyId    String
  restriction  Restriction
  status       ReviewStatus @default(PENDING)
  extraInfo    Json? // licence number, issuing authority …
  validUntil   DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([companyId, restriction])
}

/// History of EU VIES VAT-number checks (required before approving EU distributors).
model VatValidation {
  id                String              @id @default(cuid())
  companyId         String
  vatNumber         String
  result            VatValidationResult
  registeredName    String?
  registeredAddress String?
  consultationRef   String?
  checkedAt         DateTime            @default(now())
  checkedById       String?
  /// Phase 57: why it was checked (ONBOARDING | INVOICE | RECHECK | MANUAL) and the invoice it is the proof for
  purpose           String?
  invoiceId         String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, checkedAt])
  @@index([invoiceId])
}

enum AddressChangeAction {
  CREATE
  UPDATE
  REMOVE
}

enum AddressChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Phase 47d — after a company has submitted its registration, a new / changed / removed address (head office,
/// billing, warehouse, pickup, delivery, a shop's address) waits for FIRINGI's approval. `data` holds the proposed
/// address (AddressInput, normalised); FIRINGI decides with a note; on approval it is applied and the company told.
model AddressChangeRequest {
  id               String              @id @default(cuid())
  companyId        String
  addressId        String?
  action           AddressChangeAction
  kind             AddressKind
  data             Json
  /// the shop the new address belongs to (Phase 27 branches)
  branchId         String?
  status           AddressChangeStatus @default(PENDING)
  requestedById    String
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  appliedAddressId String?
  /// a scan / photo of a recent invoice from the company's own till at this address (proof the address is real)
  proofKey         String?
  proofName        String?
  proofMime        String?
  proofIssuedOn    DateTime?
  /// FIRINGI approved without the till invoice (bypass)
  proofBypassed    Boolean             @default(false)
  createdAt        DateTime            @default(now())

  company Company @relation("AddressChangeRequests", fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([companyId, status])
}

/// Phase 47e — FIRINGI lets one company buy special goods although its activity codes / declaration don't match
/// (target: TOBACCO, ALCOHOL, VAPING or "cat:<categoryId>"), with the reason.
model SpecialAccessException {
  id          String   @id @default(cuid())
  companyId   String
  target      String
  note        String
  createdById String
  createdAt   DateTime @default(now())

  company Company @relation("SpecialAccessExceptions", fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, target])
}
