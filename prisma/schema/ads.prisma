/// Phase 34 — sponsored products. Suppliers pay FIRINGI to show their products higher up.
enum AdPlacement {
  SEARCH
  CATEGORY
  HOME
  CART
}

enum AdPricing {
  CPC // pay per click, with a daily / total budget
  DAILY // fixed price per day, booked from start to end
}

enum AdStatus {
  PENDING // waiting for FIRINGI's approval
  ACTIVE
  PAUSED // by the supplier, or automatically (budget / balance)
  REJECTED
  ENDED
}

enum AdBilling {
  PAYOUT // monthly ad invoice, settled against what FIRINGI owes the supplier
  PREPAID // supplier tops up a balance first; each top-up is invoiced
  INVOICE // monthly ad invoice, paid with normal terms
}

model AdCampaign {
  id              String      @id @default(cuid())
  vendorCompanyId String
  name            String
  placement       AdPlacement
  pricing         AdPricing
  offerIds        String[]
  keywords        String[] // SEARCH: words that trigger the ad (besides matching the products)
  categoryId      String? // CATEGORY: where it shows (none = the products' own categories)
  cpcBid          Decimal?    @db.Decimal(10, 2)
  dailyBudget     Decimal?    @db.Decimal(12, 2)
  totalBudget     Decimal?    @db.Decimal(12, 2)
  dailyPrice      Decimal?    @db.Decimal(10, 2) // DAILY: price per day, fixed when booked
  startsOn        DateTime    @db.Date
  endsOn          DateTime?   @db.Date
  status          AdStatus    @default(PENDING)
  pausedReason    String? // SUPPLIER | BUDGET | BALANCE | FIRINGI
  rejectReason    String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  vendor  Company      @relation("AdCampaigns", fields: [vendorCompanyId], references: [id])
  charges AdCharge[]
  stats   AdStatDay[]

  @@index([status, placement])
  @@index([vendorCompanyId])
}

/// Impressions and clicks per campaign per day (counted, not one row each).
model AdStatDay {
  campaignId  String
  day         DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  cost        Decimal  @default(0) @db.Decimal(12, 2)

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, day])
}

/// What a supplier is charged: a click (CPC) or a booked day (DAILY). Invoiced monthly (PAYOUT / INVOICE)
/// or taken from the prepaid balance (PREPAID — invoiced at top-up).
model AdCharge {
  id             String     @id @default(cuid())
  campaignId     String
  companyId      String
  kind           String // CLICK | DAY
  amount         Decimal    @db.Decimal(10, 2)
  day            DateTime   @db.Date
  buyerCompanyId String?
  offerId        String?
  prepaid        Boolean    @default(false)
  invoiceId      String?
  dedupeKey      String?    @unique
  createdAt      DateTime   @default(now())

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([companyId, invoiceId])
  @@index([campaignId, buyerCompanyId, createdAt])
}

/// A supplier's advertising account: how FIRINGI collects (agreed with the supplier) and the prepaid balance.
model AdAccount {
  companyId String    @id
  billing   AdBilling
  balance   Decimal   @default(0) @db.Decimal(12, 2)
  updatedAt DateTime  @updatedAt
  company   Company   @relation("AdAccount", fields: [companyId], references: [id])
}

/// FIRINGI's invoices for advertising (monthly, or a prepaid top-up).
model AdInvoice {
  id          String    @id @default(cuid())
  companyId   String
  invoiceId   String    @unique
  kind        String // MONTH | TOPUP
  billing     AdBilling
  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date
  gross       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  @@index([companyId])
}
