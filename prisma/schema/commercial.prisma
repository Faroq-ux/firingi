// ───────────────────────── Commission & promotions ─────────────────────────

enum CommissionType {
  PERCENT
  FIXED_PER_UNIT // reserved — later phase
  FIXED_PER_ORDER // reserved — later phase
}

enum PromotionOwner {
  VENDOR
  ADMIN
}

enum PromotionKind {
  PERCENT
  FIXED_AMOUNT // € off per unit (net)
  ORDER_AMOUNT // € off the order (net), spread over the matching lines
  FREE_DELIVERY // the delivery fee is waived (100 % FIRINGI- or 100 % supplier-funded)
  BUY_X_GET_Y // buy `buyQty`, get `freeQty` of the same product free
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum AcceptanceStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// No default commission. Rows are never edited: a change closes the current rule
/// (validTo) and inserts a new one → full history. Orders snapshot the active rule.
model CommissionRule {
  id              String         @id @default(cuid())
  vendorCompanyId String
  type            CommissionType @default(PERCENT)
  categoryId      String? // reserved for per-category commission
  rate            Decimal        @db.Decimal(10, 4) // percent for PERCENT, money for FIXED_*
  validFrom       DateTime       @default(now())
  validTo         DateTime?
  note            String?
  createdById     String?
  createdAt       DateTime       @default(now())

  vendor     Company     @relation(fields: [vendorCompanyId], references: [id])
  category   Category?   @relation(fields: [categoryId], references: [id])
  orderLines OrderLine[]

  @@index([vendorCompanyId, validFrom])
}

/// Vendor promotions are always 100 % vendor-funded and never reduce FIRINGI commission.
/// Admin promotions declare the split (FIRINGI / vendor / e.g. 50-50). DB CHECKs enforce it.
model Promotion {
  id                       String          @id @default(cuid())
  ownerType                PromotionOwner
  ownerCompanyId           String? // vendor for VENDOR promotions
  name                     Json
  kind                     PromotionKind
  value                    Decimal         @db.Decimal(18, 4)
  firingiFundPct           Decimal         @default(0) @db.Decimal(5, 2)
  vendorFundPct            Decimal         @default(100) @db.Decimal(5, 2)
  countryId                String?
  minQty                   Int?
  minOrderValue            Decimal?        @db.Decimal(18, 2)
  validFrom                DateTime
  validTo                  DateTime?
  priority                 Int             @default(0)
  status                   PromotionStatus @default(DRAFT)
  requiresVendorAcceptance Boolean         @default(false)
  budget                   Decimal?        @db.Decimal(18, 2)
  /// Coupon: only applies when the buyer enters this code (UPPERCASE). Null = automatic.
  code                     String?         @unique
  description              Json?
  firstOrderOnly           Boolean         @default(false)
  maxRedemptions           Int?
  maxPerCustomer           Int?
  buyQty                   Int?
  freeQty                  Int?
  /// Listed on the customer's "My offers" page.
  showInOffers             Boolean         @default(true)
  createdById              String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  owner         Company?                    @relation(fields: [ownerCompanyId], references: [id])
  country       Country?                    @relation(fields: [countryId], references: [id])
  targets       PromotionTarget[]
  acceptances   PromotionVendorAcceptance[]
  lineDiscounts OrderLineDiscount[]
  redemptions   PromotionRedemption[]
  campaigns     MarketingCampaign[]
}

/// Any combination; a line matches if it matches at least one target row.
model PromotionTarget {
  id              String  @id @default(cuid())
  promotionId     String
  offerId         String?
  productId       String?
  categoryId      String?
  vendorCompanyId String?
  customerGroupId String?
  /// WHO targets (any one matches): a customer group, one buying company, a CRM segment.
  buyerCompanyId  String?
  crmSegmentId    String?

  promotion     Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  buyer         Company?       @relation("PromotionTargetBuyer", fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  segment       CrmSegment?    @relation(fields: [crmSegmentId], references: [id], onDelete: Cascade)
  offer         VendorOffer?   @relation(fields: [offerId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  vendor        Company?       @relation("PromotionTargetVendor", fields: [vendorCompanyId], references: [id])
  customerGroup CustomerGroup? @relation(fields: [customerGroupId], references: [id])
}

model PromotionVendorAcceptance {
  promotionId     String
  vendorCompanyId String
  status          AcceptanceStatus @default(PENDING)
  respondedById   String?
  respondedAt     DateTime?

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  vendor    Company   @relation(fields: [vendorCompanyId], references: [id])

  @@id([promotionId, vendorCompanyId])
}

/// A promotion used on an order (coupons, order discounts, free delivery and line offers).
/// Counted for coupon limits and budgets while the order is not cancelled.
model PromotionRedemption {
  id             String   @id @default(cuid())
  promotionId    String
  orderId        String
  buyerCompanyId String
  code           String?
  /// One use of a coupon per checkout, even when the checkout became several orders.
  checkoutId     String?
  amount         Decimal  @db.Decimal(18, 2) // discount given (net)
  firingiAmount  Decimal  @db.Decimal(18, 2)
  vendorAmount   Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer     Company   @relation("RedemptionBuyer", fields: [buyerCompanyId], references: [id])

  @@unique([promotionId, orderId])
  @@index([buyerCompanyId])
}
