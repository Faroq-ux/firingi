// ───────────────────────── Invoicing & finance ─────────────────────────
// FIRINGI issues EVERY invoice to buyers (Invoice). Vendors issue their own invoices to
// FIRINGI from their own certified software and upload them (VendorInvoice); FIRINGI
// matches them against the VendorBillingStatement it generated for the order.

enum InvoiceDocType {
  INVOICE
  INVOICE_RECEIPT
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_CREDITED
  CREDITED
}

/// Where the legally valid document stands at the certified provider (Moloni).
enum FiscalStatus {
  LOCAL // issued by FIRINGI's internal stand-in (development, or before a provider is connected)
  PENDING // waiting to be issued at the provider (queue)
  DONE // issued at the provider: providerNumber is the legal number
  FAILED // the provider refused it; finance must look (retries stop after several attempts)
}

enum TaxRegime {
  DOMESTIC
  INTRA_EU_REVERSE_CHARGE
  EXEMPT
}

enum BillingStatementStatus {
  OPEN // waiting for the vendor's invoice
  INVOICED // vendor invoice uploaded, not yet matched
  MATCHED
  DISPUTED
  CLOSED
}

enum VendorInvoiceStatus {
  SUBMITTED
  MATCHED
  DISPUTED
  APPROVED
  PAID
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  CREDITED
}

enum PaymentDirection {
  INBOUND // buyer → FIRINGI
  OUTBOUND // FIRINGI → vendor
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  MB_WAY
  MULTIBANCO
  DIRECT_DEBIT
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

/// Gap-free sequential numbering: numbers are taken with SELECT … FOR UPDATE.
model InvoiceSeries {
  id                  String         @id @default(cuid())
  legalEntityId       String
  countryId           String
  docType             InvoiceDocType
  prefix              String // e.g. "FT FIR2026"
  year                Int
  nextNumber          Int            @default(1)
  atcudValidationCode String? // PT: code given by AT when the series is registered
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())

  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id])
  country     Country     @relation(fields: [countryId], references: [id])
  invoices    Invoice[]

  @@unique([legalEntityId, docType, prefix, year])
}

/// Issued documents are immutable (DB trigger). Corrections only via credit notes.
model Invoice {
  id                 String         @id @default(cuid())
  legalEntityId      String // issuer (FIRINGI)
  seriesId           String?
  docType            InvoiceDocType
  number             Int?
  fullNumber         String?        @unique // "FT FIR2026/123"
  status             InvoiceStatus  @default(DRAFT)
  taxRegime          TaxRegime      @default(DOMESTIC)
  recipientCompanyId String
  issuerSnapshot     Json
  recipientSnapshot  Json
  orderId            String?
  originalInvoiceId  String? // for credit notes
  currencyCode       String         @default("EUR")
  netTotal           Decimal        @db.Decimal(18, 2)
  vatTotal           Decimal        @db.Decimal(18, 2)
  grossTotal         Decimal        @db.Decimal(18, 2)
  /// Phase 45: the invoice's currency (amounts above stay in EUR): eurRate = units per € used for the
  /// amounts (order's locked rate), midRate = reference rate (EUR equivalent of VAT); *Local null = EUR invoice
  eurRate            Decimal        @default(1) @db.Decimal(18, 8)
  midRate            Decimal        @default(1) @db.Decimal(18, 8)
  netTotalLocal      Decimal?       @db.Decimal(18, 2)
  vatTotalLocal      Decimal?       @db.Decimal(18, 2)
  grossTotalLocal    Decimal?       @db.Decimal(18, 2)
  issuedAt           DateTime?
  dueAt              DateTime?
  // Portuguese fiscal fields (filled by the certified provider adapter)
  atcud              String?
  hash               String?
  previousHash       String?
  qrPayload          String?
  externalProvider   String?
  externalId         String?
  /// Legal number given by the certified provider (e.g. "FT 2026/12"); fullNumber is then FIRINGI's reference.
  providerNumber     String?        @unique
  /// Provider details kept for credit notes and checks: document id, line ids, totals, warnings.
  providerData       Json?
  fiscalStatus       FiscalStatus   @default(LOCAL)
  fiscalAttempts     Int            @default(0)
  fiscalNextAt       DateTime?
  fiscalError        String?
  pdfKey             String?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  legalEntity       LegalEntity              @relation(fields: [legalEntityId], references: [id])
  series            InvoiceSeries?           @relation(fields: [seriesId], references: [id])
  recipient         Company                  @relation("InvoiceRecipient", fields: [recipientCompanyId], references: [id])
  order             Order?                   @relation(fields: [orderId], references: [id])
  originalInvoice   Invoice?                 @relation("CreditNotes", fields: [originalInvoiceId], references: [id])
  creditNotes       Invoice[]                @relation("CreditNotes")
  lines             InvoiceLine[]
  taxSummary        InvoiceTaxSummary[]
  allocations       PaymentAllocation[]
  paymentItems      PaymentRequestItem[]
  reminders         InvoiceReminder[]
  billingStatements VendorBillingStatement[]

  @@index([recipientCompanyId, issuedAt])
  @@index([orderId])
  @@index([fiscalStatus, fiscalNextAt])
  @@index([originalInvoiceId])
}

/// FIRINGI record ↔ the provider's id (customers, products), so each is created there once.
model ProviderEntityMap {
  id        String   @id @default(cuid())
  provider  String // "moloni"
  kind      String // CUSTOMER | PRODUCT
  localId   String // company id / SKU
  remoteId  String
  createdAt DateTime @default(now())

  @@unique([provider, kind, localId])
}

model InvoiceLine {
  id                String  @id @default(cuid())
  invoiceId         String
  orderLineId       String?
  position          Int
  description       String
  qty               Decimal @db.Decimal(18, 3)
  unitPriceNet      Decimal @db.Decimal(18, 4)
  discountNet       Decimal @default(0) @db.Decimal(18, 2)
  taxRate           Decimal @db.Decimal(6, 3)
  saftTaxCode       String?
  exemptionReasonId String?
  lineNet           Decimal @db.Decimal(18, 2)
  lineVat           Decimal @db.Decimal(18, 2)
  /// Phase 43: excise in this line (in the price for PAID goods; the whole line for an added-duty line)
  exciseNet         Decimal @default(0) @db.Decimal(18, 2)
  /// Phase 45: in the invoice's currency (null = EUR invoice)
  unitPriceLocal    Decimal? @db.Decimal(18, 4)
  lineNetLocal      Decimal? @db.Decimal(18, 2)
  lineVatLocal      Decimal? @db.Decimal(18, 2)

  invoice         Invoice             @relation(fields: [invoiceId], references: [id])
  orderLine       OrderLine?          @relation(fields: [orderLineId], references: [id])
  exemptionReason TaxExemptionReason? @relation(fields: [exemptionReasonId], references: [id])

  @@index([invoiceId])
}

model InvoiceTaxSummary {
  id        String  @id @default(cuid())
  invoiceId String
  taxRate   Decimal @db.Decimal(6, 3)
  base      Decimal @db.Decimal(18, 2)
  vat       Decimal @db.Decimal(18, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

/// What FIRINGI expects the vendor to invoice for an order (net of commission).
model VendorBillingStatement {
  id                String                 @id @default(cuid())
  number            String                 @unique // VBS-2026-000001
  vendorCompanyId   String
  orderId           String
  salesInvoiceId    String? // the paired FIRINGI sales invoice
  isCreditStatement Boolean                @default(false) // for returns
  taxRegime         TaxRegime              @default(DOMESTIC)
  currencyCode      String                 @default("EUR")
  expectedNet       Decimal                @db.Decimal(18, 2)
  expectedVat       Decimal                @db.Decimal(18, 2)
  expectedGross     Decimal                @db.Decimal(18, 2)
  commissionTotal   Decimal                @db.Decimal(18, 2)
  /// Phase 45: the supplier's currency per € (locked with the order); *Local = what the supplier is owed in it
  rate              Decimal                @default(1) @db.Decimal(18, 8)
  expectedNetLocal  Decimal?               @db.Decimal(18, 2)
  expectedVatLocal  Decimal?               @db.Decimal(18, 2)
  expectedGrossLocal Decimal?              @db.Decimal(18, 2)
  lines             Json // snapshot of the expected lines
  status            BillingStatementStatus @default(OPEN)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  vendor       Company                   @relation(fields: [vendorCompanyId], references: [id])
  order        Order                     @relation(fields: [orderId], references: [id])
  salesInvoice Invoice?                  @relation(fields: [salesInvoiceId], references: [id])
  allocations  VendorInvoiceAllocation[]

  @@index([vendorCompanyId])
  @@index([orderId])
  @@index([salesInvoiceId])
}

/// Invoice uploaded by the vendor (issued in the vendor's own software).
model VendorInvoice {
  id              String              @id @default(cuid())
  vendorCompanyId String
  docType         InvoiceDocType      @default(INVOICE)
  externalNumber  String // the vendor's own invoice number
  issueDate       DateTime            @db.Date
  dueDate         DateTime?           @db.Date
  taxRegime       TaxRegime           @default(DOMESTIC)
  currencyCode    String              @default("EUR")
  netTotal        Decimal             @db.Decimal(18, 2)
  vatTotal        Decimal             @db.Decimal(18, 2)
  grossTotal      Decimal             @db.Decimal(18, 2)
  /// FIRINGI self-assessed VAT for intra-EU reverse-charge purchases
  selfAssessedVat Decimal             @default(0) @db.Decimal(18, 2)
  /// Phase 45: the supplier's currency per € (from its statements); *Local = the invoice as the supplier wrote it
  rate            Decimal             @default(1) @db.Decimal(18, 8)
  netTotalLocal   Decimal?            @db.Decimal(18, 2)
  vatTotalLocal   Decimal?            @db.Decimal(18, 2)
  grossTotalLocal Decimal?            @db.Decimal(18, 2)
  fileKey         String
  structuredData  Json? // UBL / Peppol payload if provided
  status          VendorInvoiceStatus @default(SUBMITTED)
  matchResult     Json? // differences found by the matcher
  submittedById   String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  vendor             Company                   @relation(fields: [vendorCompanyId], references: [id])
  allocations        VendorInvoiceAllocation[]
  paymentAllocations PaymentAllocation[]

  @@unique([vendorCompanyId, externalNumber])
}

model VendorInvoiceAllocation {
  vendorInvoiceId String
  statementId     String
  amountNet       Decimal @db.Decimal(18, 2)

  vendorInvoice VendorInvoice          @relation(fields: [vendorInvoiceId], references: [id], onDelete: Cascade)
  statement     VendorBillingStatement @relation(fields: [statementId], references: [id])

  @@id([vendorInvoiceId, statementId])
  @@index([statementId])
}

model ReturnRequest {
  id            String       @id @default(cuid())
  orderId       String
  reason        String
  status        ReturnStatus @default(REQUESTED)
  requestedById String?
  reviewedById  String?
  reviewNote    String?
  photoKeys     String[]
  restock       Boolean      @default(true) // goods go back into the vendor's stock on receipt
  receivedAt    DateTime?
  receivedById  String?
  creditNoteId  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order Order        @relation(fields: [orderId], references: [id])
  lines ReturnLine[]

  @@index([orderId])
}

model ReturnLine {
  id          String @id @default(cuid())
  returnId    String
  orderLineId String
  qty         Int

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLine     OrderLine     @relation(fields: [orderLineId], references: [id])

  @@index([returnId])
}

model Payment {
  id             String           @id @default(cuid())
  companyId      String // payer (INBOUND) or payee (OUTBOUND)
  direction      PaymentDirection
  method         PaymentMethod
  amount         Decimal          @db.Decimal(18, 2)
  currencyCode   String           @default("EUR")
  /// Phase 45: a payment in another currency — the money that moved (amount = its EUR value at `rate`, the day's reference rate)
  amountLocal    Decimal?         @db.Decimal(18, 2)
  rate           Decimal          @default(1) @db.Decimal(18, 8)
  reference      String?
  status         PaymentStatus    @default(PENDING)
  paidAt         DateTime?
  recordedById   String?
  createdAt      DateTime         @default(now())
  /// Online payments: who processed it; refunds of the unallocated part.
  provider       String?
  refundedAmount Decimal          @default(0) @db.Decimal(18, 2)

  company     Company             @relation(fields: [companyId], references: [id])
  allocations PaymentAllocation[]
  request     PaymentRequest?
  bankMatches BankMatch[]         @relation("BankMatches")

  @@index([companyId])
}

model PaymentAllocation {
  id              String  @id @default(cuid())
  paymentId       String
  invoiceId       String? // INBOUND → FIRINGI sales invoice
  vendorInvoiceId String? // OUTBOUND → vendor invoice
  amount          Decimal @db.Decimal(18, 2)

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  vendorInvoice VendorInvoice? @relation(fields: [vendorInvoiceId], references: [id])

  @@index([invoiceId])
  @@index([paymentId])
  @@index([vendorInvoiceId])
}
