// ── Phase 56: landing page ───────────────────────────────────────────────────
// The public landing page at "/" (texts, numbers and sections are FIRINGI's settings, Setting "landing.settings").
// Visitors' questions and vendor applications become CRM leads (source WEBSITE). Newsletter sign-ups are kept
// here with double opt-in: a sign-up is PENDING until the visitor confirms from the e-mail.

enum NewsletterStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id             String           @id @default(cuid())
  email          String           @unique
  locale         String
  countryCode    String?
  source         String           @default("landing")
  status         NewsletterStatus @default(PENDING)
  /// confirm / unsubscribe links carry this (never the e-mail)
  token          String           @unique
  /// the consent wording the visitor saw (GDPR record)
  consentText    String
  /// SHA-256 of the IP and a server secret, to spot abuse without keeping the IP
  ipHash         String?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
}

/// Footer pages (FIRINGI only): an application for a job at FIRINGI, sent from /careers. Personal data — FIRINGI
/// deletes it when no longer needed (GDPR); only a link to a CV / profile is asked, no files.
model JobApplication {
  id          String   @id @default(cuid())
  /// the opening applied for ("" = an open application); its title is kept in case the opening is removed
  jobId       String   @default("")
  jobTitle    String   @default("")
  name        String
  email       String
  phone       String?
  link        String?
  message     String?
  locale      String
  /// the consent wording the applicant saw (GDPR record)
  consentText String
  ipHash      String?
  /// NEW | REVIEWING | REJECTED | HIRED
  status      String   @default("NEW")
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}
