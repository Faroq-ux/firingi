// ───────────────────────── System ─────────────────────────

enum SettingScope {
  GLOBAL
  COUNTRY
  COMPANY
}

model Setting {
  id          String       @id @default(cuid())
  scope       SettingScope
  scopeId     String       @default("") // "" for GLOBAL
  key         String
  value       Json
  updatedById String?
  updatedAt   DateTime     @updatedAt

  @@unique([scope, scopeId, key])
}

/// Gap-free counters (order numbers, statement numbers …). Use with row locks.
model Sequence {
  name      String
  year      Int
  nextValue Int    @default(1)

  @@id([name, year])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model FileObject {
  key            String   @id
  ownerCompanyId String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  sha256         String?
  uploadedById   String?
  createdAt      DateTime @default(now())
}
