// ───────────────────────── Operations (Phase 19) ─────────────────────────

/// One run of a scheduled job (notifications, allocation, AI, invoicing, backup, restore test…).
model JobRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  durationMs Int?
  summary    Json?
  error      String?

  @@index([job, startedAt])
}

/// Errors seen by the server or by users' browsers (also sent to Sentry when configured).
model ErrorEvent {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  source      String // server | browser
  message     String
  stack       String?
  path        String?
  digest      String?
  fingerprint String // groups the same error
  userAgent   String?

  @@index([at])
  @@index([fingerprint, at])
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

/// A problem FIRINGI noticed about itself. One open alert per key; resolved when it clears.
model OpsAlert {
  id         String        @id @default(cuid())
  key        String // e.g. job:notifications, backup, errors, disk
  severity   AlertSeverity
  title      String
  detail     String
  openedAt   DateTime      @default(now())
  lastSeenAt DateTime      @default(now())
  notifiedAt DateTime?
  resolvedAt DateTime?

  @@index([key, resolvedAt])
  @@index([resolvedAt, openedAt])
}
