// ───────────────────────── Cart & orders ─────────────────────────

enum OrderFlow {
  CUSTOMER_FROM_WHOLESALER
  WHOLESALER_FROM_DISTRIBUTOR
}

enum OrderStatus {
  NEW
  ON_HOLD // FIRINGI checks it (risk) before the supplier sees it
  PENDING_CONFIRMATION
  SUPPLIER_PROCESSING
  READY_FOR_PICKUP
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  EXCEPTION
}

enum DeliveryMode {
  VENDOR_FLEET // order meets the vendor's free-delivery rules → vendor delivers
  FIRINGI_FLEET // otherwise FIRINGI delivers and a fee applies
  CARRIER // third-party carrier (cross-border distributor shipments)
}

/// One cart per user per buyer company. `sellerCompanyId` locks the cart to a single
/// vendor; a DB trigger rejects items from any other vendor.
model Cart {
  id              String   @id @default(cuid())
  buyerCompanyId  String
  userId          String
  sellerCompanyId String?
  /// FIRINGI-routed cart (country in "order from FIRINGI" mode): items may come from several
  /// suppliers; FIRINGI picks the supplier(s) at checkout.
  routed          Boolean  @default(false)
  couponCode      String?
  /// Phase 32: loyalty points the buyer chose to spend at checkout.
  loyaltyPoints   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buyer  Company    @relation("CartBuyer", fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  seller Company?   @relation("CartSeller", fields: [sellerCompanyId], references: [id])
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  @@unique([buyerCompanyId, userId])
  @@index([userId])
}

model CartItem {
  id      String   @id @default(cuid())
  cartId  String
  offerId String
  qty     Int
  addedAt DateTime @default(now())

  cart  Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offer VendorOffer @relation(fields: [offerId], references: [id])

  @@unique([cartId, offerId])
}

model Order {
  id                    String        @id @default(cuid())
  number                String        @unique // FO-2026-000001
  flow                  OrderFlow
  buyerCompanyId        String
  sellerCompanyId       String
  placedByUserId        String
  countryId             String // buyer's country (tax country of FIRINGI's sale)
  currencyCode          String        @default("EUR")
  vendorCurrencyCode    String        @default("EUR")
  fxRate                Decimal       @default(1) @db.Decimal(18, 8) // vendor → buyer currency at order time
  couponCode            String?
  /// Orders placed in one checkout (a cart from several suppliers, or one FIRINGI picked) share it.
  checkoutId            String?
  /// Delivery fee waived by a FIRINGI-funded free-delivery offer (FIRINGI still pays a supplier's flat rate).
  deliveryDiscountNet   Decimal       @default(0) @db.Decimal(18, 2)
  deliveryPromotionId   String?
  status                OrderStatus   @default(NEW)
  /// Held (ON_HOLD) until the buyer pays — pay-before-shipping buyers.
  awaitingPayment       Boolean       @default(false)
  deliveryMode          DeliveryMode?
  deliveryAddress       Json // snapshot
  sourceAddressId       String?
  deliveryRuleId        String?
  requestedDeliveryDate DateTime?
  buyerNotes            String?
  parentOrderId         String? // admin split / re-allocation
  routedByFiringi       Boolean       @default(false) // customer ordered from FIRINGI; FIRINGI picked the supplier
  /// Phase 27: the buyer's branch (from the delivery address), its cost centre and the buyer's PO reference
  branchId              String?
  costCentre            String?
  poReference           String?

  // Totals (frozen at placement, recalculated on vendor confirmation)
  listNet          Decimal @default(0) @db.Decimal(18, 2)
  discountTotal    Decimal @default(0) @db.Decimal(18, 2)
  deliveryFeeNet   Decimal @default(0) @db.Decimal(18, 2)
  netTotal         Decimal @default(0) @db.Decimal(18, 2)
  vatTotal         Decimal @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal @default(0) @db.Decimal(18, 2)
  commissionTotal  Decimal @default(0) @db.Decimal(18, 2)
  vendorPayableNet Decimal @default(0) @db.Decimal(18, 2)
  firingiMarginNet Decimal @default(0) @db.Decimal(18, 2)

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer             Company                  @relation("OrderBuyer", fields: [buyerCompanyId], references: [id])
  branch            Branch?                  @relation("BranchOrders", fields: [branchId], references: [id], onDelete: SetNull)
  seller            Company                  @relation("OrderSeller", fields: [sellerCompanyId], references: [id])
  placedBy          User                     @relation("OrderPlacedBy", fields: [placedByUserId], references: [id])
  country           Country                  @relation(fields: [countryId], references: [id])
  sourceAddress     Address?                 @relation("OrderSourceAddress", fields: [sourceAddressId], references: [id])
  deliveryRule      DeliveryRule?            @relation(fields: [deliveryRuleId], references: [id])
  parentOrder       Order?                   @relation("OrderSplit", fields: [parentOrderId], references: [id])
  childOrders       Order[]                  @relation("OrderSplit")
  lines             OrderLine[]
  statusHistory     OrderStatusHistory[]
  exceptions        OrderException[]
  stockMovements    StockMovement[]
  invoices          Invoice[]
  paymentRequests   PaymentRequest[]
  billingStatements VendorBillingStatement[]
  returns           ReturnRequest[]
  claims            QualityClaim[]           @relation("ClaimOrder")
  delivery          Delivery?
  chatThreads       OrderThread[]
  allocations       AllocationEvent[]
  supportTickets    SupportTicket[]
  rating            OrderRating?
  redemptions       PromotionRedemption[]
  risk              RiskAssessment?

  purchaseOrder  PurchaseOrder?
  purchasedLots  PurchasedLot[]  @relation("PurchasedLotOrder")
  pickLists      PickListOrder[] @relation("PickListOrderOrder")
  /// a wholesaler put this delivered order into its own stock (Phase 24)
  buyerStockedAt DateTime?

  @@index([buyerCompanyId, placedAt])
  @@index([sellerCompanyId, placedAt])
  @@index([checkoutId])
  @@index([status])
  @@index([parentOrderId])
  @@index([placedByUserId])
  @@index([branchId, placedAt])
}

/// Every commercial number is frozen on the line so finance reports stay correct even
/// when prices, promotions or commission rates change later.
model OrderLine {
  id            String @id @default(cuid())
  orderId       String
  offerId       String
  productName   Json // snapshot
  sku           String
  packagingName Json
  qtyOrdered    Int
  qtyConfirmed  Int?
  qtyDelivered  Int?

  unitListPriceNet      Decimal @db.Decimal(18, 4) // vendor price before any discount
  vendorDiscountNet     Decimal @default(0) @db.Decimal(18, 4) // per unit, from vendor promotions
  adminDiscountNet      Decimal @default(0) @db.Decimal(18, 4) // per unit, from admin promotions
  firingiFundedDiscount Decimal @default(0) @db.Decimal(18, 4) // per unit, paid by FIRINGI
  vendorFundedDiscount  Decimal @default(0) @db.Decimal(18, 4) // per unit, paid by vendor
  unitSalePriceNet      Decimal @db.Decimal(18, 4) // what the buyer pays per unit (net)

  taxRate Decimal @db.Decimal(6, 3)
  lineNet Decimal @db.Decimal(18, 2)
  lineVat Decimal @db.Decimal(18, 2)

  commissionRuleId  String?
  commissionType    CommissionType?
  commissionRate    Decimal?        @db.Decimal(10, 4)
  commissionBase    Decimal         @default(0) @db.Decimal(18, 2) // always pre-discount list net
  commissionAmount  Decimal         @default(0) @db.Decimal(18, 2)
  vendorUnitCostNet Decimal         @db.Decimal(18, 4) // what FIRINGI pays the vendor per unit
  vendorLineNet     Decimal         @db.Decimal(18, 2)

  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offer          VendorOffer         @relation(fields: [offerId], references: [id])
  commissionRule CommissionRule?     @relation(fields: [commissionRuleId], references: [id])
  discounts      OrderLineDiscount[]
  invoiceLines   InvoiceLine[]
  returnLines    ReturnLine[]
  claimLines     QualityClaimLine[]  @relation("ClaimOrderLine")

  @@index([orderId])
}

/// Who funded each discount on each line (finance reporting).
model OrderLineDiscount {
  id            String  @id @default(cuid())
  orderLineId   String
  promotionId   String
  amount        Decimal @db.Decimal(18, 2) // line total
  firingiAmount Decimal @db.Decimal(18, 2)
  vendorAmount  Decimal @db.Decimal(18, 2)

  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@index([orderLineId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?
  byUserId   String?
  at         DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
}

model OrderException {
  id           String    @id @default(cuid())
  orderId      String
  type         String // STOCK_SHORT | DELIVERY_FAILED | PAYMENT | PRICE_MISMATCH | OTHER
  description  String
  isResolved   Boolean   @default(false)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
