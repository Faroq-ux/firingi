// ───────────────────────── EU trade reporting (Phase 57) ─────────────────────────
// FIRINGI invoices every buyer and buys from every supplier, so FIRINGI's own entity reports the EU
// movements: the EC Sales List (recapitulative statement), Intrastat arrivals (goods FIRINGI bought from a
// supplier in another EU country) and dispatches (goods FIRINGI sold into another EU country). Lines are
// rebuilt from the issued documents until FIRINGI files the period; later credit notes become correction lines.

enum TradeReturnKind {
  ECSL // EC Sales List / recapitulative statement (VIES)
  ARRIVALS // Intrastat arrivals
  DISPATCHES // Intrastat dispatches
}

enum TradeReturnStatus {
  OPEN // lines rebuilt from the documents
  READY // checked by finance, waiting to be filed
  FILED // frozen; later changes go into the next period as corrections
}

enum TradeCodeStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model TradeReturn {
  id              String            @id @default(cuid())
  legalEntityId   String
  kind            TradeReturnKind
  period          String // "2026-11" (monthly) or "2026-Q4" (quarterly)
  periodStart     DateTime          @db.Date
  periodEnd       DateTime          @db.Date // exclusive
  dueOn           DateTime          @db.Date
  status          TradeReturnStatus @default(OPEN)
  totalValue      Decimal           @default(0) @db.Decimal(18, 2)
  totalMassKg     Decimal           @default(0) @db.Decimal(18, 3)
  lineCount       Int               @default(0)
  problemCount    Int               @default(0)
  correctionCount Int               @default(0)
  builtAt         DateTime?
  readyAt         DateTime?
  readyById       String?
  filedAt         DateTime?
  filedById       String?
  /// the authority's receipt / submission reference
  filingRef       String?
  note            String?
  /// reminder days already sent before the deadline
  remindedDays    Int[]             @default([])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  legalEntity LegalEntity       @relation(fields: [legalEntityId], references: [id])
  lines       TradeReturnLine[]

  @@unique([legalEntityId, kind, period])
  @@index([status, dueOn])
}

/// One document line (or document, for services) in a return. Files aggregate them as each layout needs.
model TradeReturnLine {
  id               String    @id @default(cuid())
  returnId         String
  position         Int
  partnerCountry   String // ISO code (Greece is written EL in VIES files)
  partnerVat       String? // with country prefix
  partnerName      String?
  partnerCompanyId String?
  /// ECSL: GOODS | TRIANGULAR | SERVICES
  indicator        String?
  cnCode           String?
  description      String?
  originCountry    String?
  netMassKg        Decimal?  @db.Decimal(18, 3)
  suppQty          Decimal?  @db.Decimal(18, 3)
  suppUnit         String?
  /// invoiced value in EUR; negative for corrections that reduce
  value            Decimal   @db.Decimal(18, 2)
  natureCode       String?
  transportMode    String?
  deliveryTerms    String?
  /// a correction of a period that was already filed (credit note / returned goods after filing)
  correctsPeriod   String?
  sourceType       String // INVOICE | CREDIT_NOTE | STATEMENT | CREDIT_STATEMENT
  sourceId         String
  sourceNumber     String?
  sourceDate       DateTime?
  orderId          String?
  productId        String?
  /// MISSING_CN | BAD_CN | MISSING_MASS | MISSING_ORIGIN | MISSING_VAT | VAT_NOT_VALID
  problems         String[]  @default([])

  tradeReturn TradeReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([sourceId])
}

/// A supplier's customs data for a product (CN8 code, net mass, supplementary units, origin) — FIRINGI checks it.
model TradeCodeProposal {
  id                String          @id @default(cuid())
  productId         String
  packagingUnitId   String?
  companyId         String
  cnCode            String?
  netWeightKg       Decimal?        @db.Decimal(10, 3)
  suppUnits         Decimal?        @db.Decimal(12, 3)
  originCountryCode String?
  note              String?
  status            TradeCodeStatus @default(PENDING)
  reviewNote        String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdById       String?
  createdAt         DateTime        @default(now())

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  packaging PackagingUnit? @relation(fields: [packagingUnitId], references: [id], onDelete: Cascade)
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([productId])
}
